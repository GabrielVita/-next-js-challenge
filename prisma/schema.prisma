datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id        String   @id
  password  String
  name      String
  avatar    String?  @db.Text
  gender    String
  age       Int
  
  // RELAÇÃO ATUALIZADA: Muitos para Muitos com Hobby
  hobbies   Hobby[]  @relation("UserHobbies")

  friends   User[]   @relation("UserFriends")
  friendOf  User[]   @relation("UserFriends")
  events    Event[]
  wishlist  Gift[]   @relation("UserWishlist")
  createdAt DateTime @default(now())
}

model Hobby {
  id    String @id @default(cuid())
  name  String @unique
  
  users User[] @relation("UserHobbies")
  gifts Gift[] @relation("GiftCategories")
}

model Event {
  id              String   @id @default(cuid())
  name            String
  isPublic        Boolean  @default(false)
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id])
  recipientName   String
  recipientUserId String?
  giftId          String?
  gift            Gift?    @relation(fields: [giftId], references: [id])
  createdAt       DateTime @default(now())
}

model Gift {
  id           String   @id @default(cuid())
  title        String
  description  String
  image        String?  @db.Text
  targetGender String?
  minAge       Int      @default(0)
  maxAge       Int      @default(100)
  
  // RELAÇÃO ATUALIZADA: Categorias agora são Hobbies
  categories   Hobby[]  @relation("GiftCategories")

  likedBy      User[]   @relation("UserWishlist")
  events       Event[]
  createdAt    DateTime @default(now())
}